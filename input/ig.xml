<?xml version="1.0" encoding="UTF-8"?>
<!-- This is a sample IG intended to be copied and adapted.

  Before using it for a new project:
  - Replace all occurrences of "myig" with your IG identifier.
  - Update the canonical URL and package ID.
  - Replace placeholder values for name, title, publisher and description.
  - Review the version, jurisdiction, dependencies and other configuration.
  - Replace the sample profiles, examples and narrative pages as required. -->
<ImplementationGuide xmlns="http://hl7.org/fhir">
  <id value="hl7.fhir.au.sample.myig"/>
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
   <valueCode value="informative"/> 
  </extension> 
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm">
    <valueInteger value="0"/> 
  </extension>
  <url value="http://draft.hl7.org.au/fhir/sample/ImplementationGuide/hl7.fhir.au.sample.myig"/>
  <!-- This version will propagate to all artifacts unless the "propagate-version" extension is overridden -->
  <version value="0.0.1"/>
  <name value="YourComputableIGNameHere"/>
  <title value="Your User Friendly IG Title Here"/>
  <status value="draft"/>
  <experimental value="true"/>
  <publisher value="Your Organisation or Project Name"/>
  <contact>
    <telecom>
      <!-- Or whatever URL and/or email address(es) are appropriate -->
      <system value="url"/>
      <value value="http://example.org/Special/committees/[something]"/>
    </telecom>
  </contact>
  <description value="A brief description of the purpose and scope of your IG."/>
  <jurisdiction>
		<coding>
			<system value="urn:iso:std:iso:3166"/>
			<code value="AU"/>
		</coding>
	</jurisdiction>
  <packageId value="hl7.fhir.au.sample.myig"/>
  <!-- This should be changed to 'not-open-source' or another license if appropriate for non-HL7-published content -->
  <license value="CC0-1.0"/>
  <!-- This is whatever FHIR version(s) the IG artifacts are targeting (not the version of this file, which should always be 'current release') -->
  <fhirVersion value="4.0.1"/>
<!--<dependsOn>
		<uri value="http://hl7.org.au/fhir/ImplementationGuide/hl7.fhir.au.base"/>
		<packageId value="hl7.fhir.au.base"/>
		<version value="current"/>
	</dependsOn>
  <dependsOn>
		<uri value="http://hl7.org.au/fhir/core/ImplementationGuide/hl7.fhir.au.core"/>
		<packageId value="hl7.fhir.au.core"/>
		<version value="current"/>
	</dependsOn> -->
  <definition>
    <!-- You don't need to define any groupings.  The IGPublisher will define them for you.  You only need to do so if your IG is 'special' and it's
      inappropriate to use the defaults.  Feel free to provide feedback about the defaults... -->
    <!--PROFILES-->
    <resource>
      <reference>
        <reference value="StructureDefinition/myobservation"/>
      </reference>
      <description value="Sample profile as placeholder"/>
    </resource>
    <!--EXAMPLES-->
    <resource>
      <reference>
        <reference value="Observation/example"/>
      </reference>
      <name value="Observation example"/>
      <description value="Observation example as placeholder for page"/>
      <exampleCanonical value="http://draft.hl7.org.au/fhir/sample/StructureDefinition/myobservation"/>
    </resource>
    <!-- PAGES-->
		<page>
			<nameUrl value="toc.html"/>
			<title value="Table of Contents"/>
			<generation value="html"/>
			<page>
				<nameUrl value="index.html"/>
				<title value="Home"/>
				<generation value="markdown"/>
			</page>
			<page>
				<nameUrl value="guidance.html"/>
				<title value="Guidance"/>
				<generation value="markdown"/>
			</page>
			<page>
				<nameUrl value="artefacts.html"/>
				<title value="FHIR artefacts"/>
				<generation value="markdown"/>
				<page>
					<nameUrl value="artifacts.html"/>
					<title value="Artefacts Summary"/>
					<generation value="html"/>
				</page>
				<page>
					<nameUrl value="profiles-and-extensions.html"/>
					<title value="Profiles and Extensions"/>
					<generation value="markdown"/>
				</page>
				<page>
					<nameUrl value="terminology.html"/>
					<title value="Terminology"/>
					<generation value="markdown"/>
				</page>
			</page>
			<page>
				<nameUrl value="examples.html"/>
				<title value="Examples"/>
				<generation value="markdown"/>
			</page>
			<page>
				<nameUrl value="support.html"/>
				<title value="Support"/>
				<generation value="markdown"/>
				<page>
					<nameUrl value="downloads.html"/>
					<title value="Downloads"/>
					<generation value="markdown"/>
				</page>
				<page>
					<nameUrl value="license.html"/>
					<title value="License and Legal"/>
					<generation value="markdown"/>
				</page>
			</page>
		</page>
    <!-- copyright year is a mandatory parameter -->
    <parameter>
      <code value="copyrightyear"/>
      <value value="2026+"/>
    </parameter>
    <!-- releaselabel should be the ballot status for HL7-published IGs. -->
		<parameter>
			<code value="releaselabel"/>
			<value value="CI Build"/>
		</parameter>
		<parameter>
			<code value="fmm-definition"/>
			<value value="https://build.fhir.org/ig/hl7au/au-fhir-base/generalguidance.html#maturity-levels"/>
		</parameter>
		<parameter>
			<code value="path-resource"/>
			<value value="input/resources"/>
		</parameter>
		<parameter>
			<code value="shownav"/>
			<value value="false"/>
		</parameter>
		<parameter>
			<code value="apply-version"/>
			<value value="true"/>
		</parameter>
		<parameter>
			<code value="apply-jurisdiction"/>
			<value value="true"/>
		</parameter>
		<parameter>
			<code value="apply-publisher"/>
			<value value="true"/>
		</parameter>
		<parameter>
			<code value="show-inherited-invariants"/>
			<value value="true"/>
		</parameter>
		<parameter>
			<code value="excludemap"/>
			<value value="true"/>
		</parameter>
		<parameter>
			<code value="path-expansion-params"/>
			<value value="../input/_resources/exp-params.json"/>
		</parameter>
    <!-- if you need to include resources that do not use this ig canonical namespace. -->
		<!--<parameter>
			<code value="special-url"/>
			<value value="http://terminology.hl7.org.au/ValueSet/service-provision-conditions"/>
		</parameter>-->
	<!--  Marks up generated pages with differences from the specified version.. -->
		<!--<parameter>
			<code value="version-comparison-master"/>
			<value value="6.0.0"/>
		</parameter>-->
  </definition>
</ImplementationGuide>
